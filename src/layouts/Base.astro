---
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "@fontsource/pinyon-script/400.css";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import { evento } from "../data/evento";

const titulo = `Formatura de ${evento.primeiroNome} · ${evento.curso}`;
const descricao = `${evento.diaSemana}, ${evento.dataExtenso}, às ${evento.horario} · ${evento.local.nome} (${evento.local.bairro}). Confirme sua presença até ${evento.confirmarAte}!`;
const og = new URL("/og.jpg", Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a0a11" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
