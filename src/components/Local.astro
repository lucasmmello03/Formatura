---
import { evento, mapas } from "../data/evento";
const { local } = evento;
---
<section class="local" id="local">
  <div class="local__texto">
    <p class="eyebrow" data-revela>Onde vai ser a festa</p>
    <h2 data-revela>{local.nome}</h2>
    <p class="local__onde" data-revela>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5"/></svg>
      {local.bairro} · {local.cidade}
    </p>
    <p class="local__quando" data-revela>
      {evento.diaSemana}, {evento.dataExtenso} · {evento.horario}
    </p>
    <div class="local__botoes" data-revela>
      <a class="btn btn--cheio" href={mapas.google} target="_blank" rel="noopener">Abrir no Google Maps</a>
      <a class="btn" href={mapas.waze} target="_blank" rel="noopener">Ir com Waze</a>
    </div>
  </div>

  <div class="local__mapa" data-revela data-mapa={mapas.embed}>
    <button type="button" class="local__carregar" data-mapa-botao>
      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5"/></svg>
      <strong>Ver mapa aqui</strong>
      <small>O mapa é do Google e só carrega se você tocar.</small>
    </button>
  </div>
</section>

<style>
  .local {
    background: var(--creme); color: var(--tinta);
    padding: clamp(5rem, 14vh, 8rem) var(--gutter);
    display: grid; gap: 2.5rem; align-items: center;
    max-width: 1200px; margin: 0 auto;
  }
  :global(main) > .local { max-width: none; }
  .local__texto { text-align: center; }
  .eyebrow { color: var(--magenta); }
  h2 {
    font-family: var(--serif); font-weight: 600;
    font-size: clamp(2.6rem, 9vw, 4.8rem); line-height: 1; margin-top: .75rem;
    color: var(--vinho);
  }
  .local__onde {
    display: inline-flex; align-items: center; gap: .4rem; margin-top: 1rem;
    font-weight: 700; font-size: 1.1rem; color: var(--magenta);
  }
  .local__quando { margin-top: .4rem; color: #6b5058; }
  .local__botoes { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1.75rem; }
  .btn {
    padding: .85rem 1.4rem; border-radius: 999px; text-decoration: none;
    font-weight: 700; font-size: .95rem;
    border: 2px solid var(--vinho); color: var(--vinho);
    transition: transform .2s, background .2s, color .2s;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn--cheio { background: var(--vinho); color: var(--creme); }
  .btn:focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; }

  .local__mapa {
    border-radius: calc(var(--raio) + 6px); overflow: hidden;
    border: 6px solid #fff;
    box-shadow: 0 24px 50px -24px rgba(142,27,63,.45);
    aspect-ratio: 4 / 3; background: #eadfd9;
  }
  .local__mapa :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .local__carregar {
    width: 100%; height: 100%; display: grid; place-content: center; justify-items: center; gap: .35rem;
    border: 0; cursor: pointer; font: inherit; color: var(--vinho); text-align: center; padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 45%, rgba(232,62,140,.18), transparent 55%),
      repeating-linear-gradient(45deg, #efe4de 0 14px, #eadcd5 14px 28px);
  }
  .local__carregar strong { font-size: 1.1rem; }
  .local__carregar small { font-size: .82rem; color: #6b5058; max-width: 26ch; }
  .local__carregar:hover strong, .local__carregar:focus-visible strong { text-decoration: underline; }
  .local__carregar:focus-visible { outline: 3px solid var(--coral); outline-offset: -3px; }

  @media (min-width: 900px) {
    .local { grid-template-columns: 1fr 1.1fr; gap: 4rem; padding-inline: max(var(--gutter), calc((100vw - 1200px) / 2)); }
    .local__texto { text-align: left; }
    .local__botoes { justify-content: flex-start; }
  }
</style>

<script>
  // Privacidade: o iframe do Google só é criado quando a pessoa pede.
  const caixa = document.querySelector<HTMLElement>("[data-mapa]");
  const botao = caixa?.querySelector<HTMLButtonElement>("[data-mapa-botao]");
  botao?.addEventListener("click", () => {
    const iframe = document.createElement("iframe");
    iframe.src = caixa!.dataset.mapa!;
    iframe.title = "Mapa do local da festa";
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    iframe.setAttribute("sandbox", "allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox");
    caixa!.replaceChildren(iframe);
  });
</script>
