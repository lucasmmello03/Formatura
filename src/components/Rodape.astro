---
import { evento } from "../data/evento";
---
<footer class="rodape">
  <p class="script">Com amor,</p>
  <p class="rodape__nome">{evento.assinatura}</p>
</footer>

<style>
  .rodape { background: var(--noite); text-align: center; padding: 4rem var(--gutter) 3rem; }
  .script { font-size: 2.2rem; color: var(--rosa); }
  .rodape__nome { font-family: var(--serif); font-size: 1.6rem; letter-spacing: .08em; }
</style>
