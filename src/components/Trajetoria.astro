---
import { Image } from "astro:assets";
import estudos from "../assets/fotos/estudos.jpg";
import oab from "../assets/fotos/oab.jpg";
import capelo from "../assets/fotos/capelo.jpg";

const momentos = [
  {
    foto: estudos,
    alt: "Yane lendo a CLT, sorrindo, em uma biblioteca",
    titulo: "Os estudos",
    texto: "Entre códigos, leis e madrugadas, cada página me trouxe até aqui.",
  },
  {
    foto: oab,
    alt: "Yane de vestido vinho segurando o certificado de aprovação na OAB",
    titulo: "A aprovação",
    texto: "Aprovada no Exame da Ordem: um sonho que virou realidade.",
  },
  {
    foto: capelo,
    alt: "Yane de beca, sorrindo, com o capelo apoiado no rosto",
    titulo: "A formatura",
    texto: "E agora, o momento de celebrar — e eu quero você comigo.",
  },
];
---
<section class="traj" data-traj>
  <div class="traj__trilho" data-traj-trilho>
    <header class="traj__intro">
      <p class="eyebrow">A trajetória</p>
      <h2>Cada passo <em>valeu a pena</em></h2>
    </header>

    {momentos.map((m, i) => (
      <figure class="traj__card">
        <div class="traj__moldura">
          <Image
            src={m.foto}
            alt={m.alt}
            widths={[400, 700, 1000]}
            sizes="(min-width: 900px) 34vw, 78vw"
            data-traj-img
          />
        </div>
        <figcaption>
          <span class="traj__num">0{i + 1}</span>
          <h3>{m.titulo}</h3>
          <p>{m.texto}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .traj {
    background: radial-gradient(ellipse at 30% 0%, #3a0f22 0%, var(--noite) 60%);
    padding: 6rem 0;
    overflow: hidden;
  }
  /* Sem animação: lista vertical */
  .traj__trilho {
    display: flex; flex-direction: column; gap: 4rem;
    padding: 0 var(--gutter);
  }
  .traj__intro h2 {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1.05; margin-top: .75rem;
  }
  .traj__intro em { color: var(--rosa); }
  .eyebrow { color: var(--coral); }

  .traj__card { max-width: 520px; }
  .traj__moldura {
    overflow: hidden; border-radius: var(--raio);
    aspect-ratio: 4 / 5;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,.6);
  }
  .traj__moldura :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%;
    will-change: transform;
  }
  figcaption { margin-top: 1.25rem; }
  .traj__num { font-family: var(--serif); color: var(--rosa); font-size: 1.1rem; }
  figcaption h3 { font-family: var(--serif); font-weight: 600; font-size: 1.9rem; line-height: 1.1; }
  figcaption p { color: var(--texto-suave); margin-top: .35rem; max-width: 34ch; }

  /* Com animação: trilho horizontal fixado durante a rolagem */
  :global(.anim) .traj { padding: 0; }
  :global(.anim) .traj__trilho {
    flex-direction: row; align-items: center;
    width: max-content; height: 100svh;
    gap: clamp(2rem, 6vw, 6rem);
    padding: 0 var(--gutter);
  }
  :global(.anim) .traj__intro { width: min(78vw, 420px); flex: none; }
  :global(.anim) .traj__card { width: min(78vw, 34vw + 120px, 460px); flex: none; }
  :global(.anim) .traj__moldura { height: min(58svh, 560px); aspect-ratio: auto; }
  :global(.anim) .traj__moldura :global(img) { width: 118%; max-width: none; }
  :global(.anim) .traj__card:nth-child(odd) { transform: translateY(6svh); }
  :global(.anim) .traj__card:nth-child(even) { transform: translateY(-4svh); }

  @media (prefers-reduced-motion: reduce) {
    :global(.anim) .traj__trilho { flex-direction: column; width: auto; height: auto; padding: 6rem var(--gutter); }
    :global(.anim) .traj__moldura { height: auto; aspect-ratio: 4 / 5; }
    :global(.anim) .traj__moldura :global(img) { width: 100%; }
    :global(.anim) .traj__card { transform: none !important; }
  }
</style>
