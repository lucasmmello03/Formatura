---
import { Image } from "astro:assets";
import estudos from "../assets/fotos/estudos.jpg";
import oab from "../assets/fotos/oab.jpg";
import capelo from "../assets/fotos/capelo.jpg";

const momentos = [
  {
    foto: estudos,
    alt: "Yane lendo a CLT, sorrindo, em uma biblioteca",
    titulo: "Os estudos",
    texto: "Entre códigos, leis e madrugadas, cada página me trouxe até aqui.",
  },
  {
    foto: oab,
    alt: "Yane de vestido vinho segurando o certificado de aprovação na OAB",
    titulo: "A aprovação",
    texto: "Aprovada no Exame da Ordem: um sonho que virou realidade.",
  },
  {
    foto: capelo,
    alt: "Yane de beca, sorrindo, com o capelo apoiado no rosto",
    titulo: "A formatura",
    texto: "E agora, o momento de celebrar — e eu quero você comigo.",
  },
];
---
<section class="traj" data-traj>
  <div class="traj__faixa" data-traj-faixa>
    <header class="traj__intro">
      <p class="eyebrow">A trajetória</p>
      <h2>Cada passo <em>valeu a pena</em></h2>
      <p class="traj__dica" aria-hidden="true">Deslize para o lado <span>→</span></p>
    </header>

    <div class="traj__trilho" data-traj-trilho tabindex="0" aria-label="Fotos da trajetória">
      {momentos.map((m, i) => (
        <figure class="traj__card">
          <div class="traj__moldura">
            <Image
              src={m.foto}
              alt={m.alt}
              widths={[400, 700, 1000]}
              sizes="(min-width: 900px) 34vw, 80vw"
              data-traj-img
            />
          </div>
          <figcaption>
            <span class="traj__num">0{i + 1}</span>
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="traj__pontos" data-traj-pontos aria-hidden="true">
      {momentos.map((_, i) => <span class:list={[{ ativo: i === 0 }]}></span>)}
    </div>
  </div>
</section>

<style>
  .traj {
    background: radial-gradient(ellipse at 30% 0%, #3a0f22 0%, var(--noite) 60%);
    padding: 5rem 0 4.5rem;
    overflow: hidden;
  }
  .traj__intro { padding: 0 var(--gutter); }
  .traj__intro h2 {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1.05; margin-top: .75rem;
  }
  .traj__intro em { color: var(--rosa); }
  .eyebrow { color: var(--coral); }
  .traj__dica {
    margin-top: 1rem; font-size: .85rem; font-weight: 600; letter-spacing: .04em; color: var(--texto-suave);
  }
  .traj__dica span { display: inline-block; color: var(--rosa); animation: dica 1.6s ease-in-out infinite; }
  @keyframes dica { 50% { transform: translateX(6px) } }

  /* Padrão (celular/tablet): carrossel nativo, deslizado com o dedo */
  .traj__trilho {
    display: flex; gap: 1rem;
    margin-top: 2rem;
    padding: 0 var(--gutter) .5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .traj__trilho::-webkit-scrollbar { display: none; }
  .traj__trilho:focus-visible { outline: 2px solid var(--coral); outline-offset: 4px; }

  .traj__card {
    flex: 0 0 min(80vw, 420px);
    scroll-snap-align: start;
  }
  .traj__moldura {
    overflow: hidden; border-radius: var(--raio);
    aspect-ratio: 4 / 5;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,.6);
    background: #2a1018;
  }
  .traj__moldura :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%;
  }
  figcaption { margin-top: 1.1rem; }
  .traj__num { font-family: var(--serif); color: var(--rosa); font-size: 1.1rem; }
  figcaption h3 { font-family: var(--serif); font-weight: 600; font-size: 1.8rem; line-height: 1.1; }
  figcaption p { color: var(--texto-suave); margin-top: .35rem; max-width: 34ch; }

  .traj__pontos { display: flex; justify-content: center; gap: .5rem; margin-top: 1.75rem; }
  .traj__pontos span {
    width: 8px; height: 8px; border-radius: 99px; background: rgba(248,242,238,.25);
    transition: width .3s, background .3s;
  }
  .traj__pontos span.ativo { width: 24px; background: var(--rosa); }

  /* Computador (mouse) com animação: trilho horizontal fixado durante a rolagem */
  :global(.traj-pin) .traj { padding: 0; }
  :global(.traj-pin) .traj__faixa {
    display: flex; align-items: center;
    width: max-content; height: 100vh;
    gap: clamp(2rem, 5vw, 5rem);
    padding: 0 var(--gutter);
    will-change: transform;
  }
  :global(.traj-pin) .traj__intro { width: 400px; flex: none; padding: 0; }
  :global(.traj-pin) .traj__dica, :global(.traj-pin) .traj__pontos { display: none; }
  :global(.traj-pin) .traj__trilho {
    overflow: visible; margin: 0; padding: 0;
    gap: clamp(2rem, 5vw, 5rem); align-items: center;
  }
  :global(.traj-pin) .traj__card { flex: 0 0 min(34vw + 120px, 460px); }
  :global(.traj-pin) .traj__moldura { height: min(58vh, 560px); aspect-ratio: auto; }
  :global(.traj-pin) .traj__moldura :global(img) { width: 118%; max-width: none; will-change: transform; }
  :global(.traj-pin) .traj__card:nth-child(odd) { transform: translateY(6vh); }
  :global(.traj-pin) .traj__card:nth-child(even) { transform: translateY(-4vh); }

  @media (prefers-reduced-motion: reduce) {
    .traj__dica span { animation: none; }
  }
</style>
