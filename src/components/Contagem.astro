---
import { evento, linkAgenda } from "../data/evento";
const unidades = [
  { u: "dias", rotulo: "dias" },
  { u: "horas", rotulo: "horas" },
  { u: "min", rotulo: "min" },
  { u: "seg", rotulo: "seg" },
];
---
<section class="contagem" id="contagem">
  <p class="eyebrow" data-revela>Contagem regressiva para a festa</p>

  <div class="contagem__grade" data-contagem={evento.dataIso} data-revela role="timer" aria-live="off">
    {unidades.map(({ u, rotulo }) => (
      <div class="contagem__bloco">
        <span class="contagem__num" data-u={u}>--</span>
        <small>{rotulo}</small>
      </div>
    ))}
  </div>
  <p class="contagem__hoje" data-contagem-hoje hidden>É hoje! 🎉 Nos vemos às {evento.horario}.</p>

  <p class="contagem__data" data-revela>
    <span class="contagem__dia">{evento.diaSemana},</span>
    <time datetime={evento.dataIso}>{evento.dataExtenso}</time>
    <span class="contagem__hora">às {evento.horario}</span>
  </p>

  <div class="contagem__agenda" data-revela>
    <a href={linkAgenda()} target="_blank" rel="noopener">+ Google Agenda</a>
    <a href="/formatura.ics" download="formatura-yane.ics">+ iPhone / Outlook</a>
  </div>
</section>

<style>
  .contagem {
    position: relative;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(232,62,140,.18), transparent 60%),
      var(--verde);
    color: var(--creme);
    padding: clamp(5rem, 14vh, 8rem) var(--gutter);
    text-align: center;
  }
  .eyebrow { color: #f6c2d7; }

  .contagem__grade {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(.5rem, 2vw, 1.25rem);
    max-width: 820px; margin: 2rem auto 0;
  }
  .contagem__bloco {
    background: rgba(248,242,238,.07);
    border: 1px solid rgba(248,242,238,.18);
    border-radius: var(--raio);
    padding: clamp(1rem, 3vw, 1.75rem) .25rem;
  }
  .contagem__bloco:first-child {
    background: var(--creme); color: var(--vinho); border-color: transparent;
  }
  .contagem__num {
    display: block; font-family: var(--serif); font-weight: 600;
    font-size: clamp(2.6rem, 11vw, 5.5rem); line-height: .95;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .contagem__num.tick { animation: tick .45s cubic-bezier(.2,.8,.2,1); }
  @keyframes tick { from { transform: translateY(-.25em); opacity: .2 } to { transform: none; opacity: 1 } }
  .contagem__bloco small {
    display: block; margin-top: .5rem;
    font-size: clamp(.62rem, 2.4vw, .8rem); font-weight: 700;
    letter-spacing: .16em; text-transform: uppercase; opacity: .8;
  }
  .contagem__hoje { font-family: var(--serif); font-size: clamp(2rem, 6vw, 3rem); margin-top: 1.5rem; }

  .contagem__data {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: .15rem .6rem;
    margin-top: 2.5rem;
    font-family: var(--serif); font-size: clamp(1.5rem, 4.5vw, 2.2rem); line-height: 1.2;
  }
  .contagem__dia, .contagem__hora { font-style: italic; color: #f6c2d7; }

  .contagem__agenda { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1.75rem; }
  .contagem__agenda a {
    padding: .7rem 1.2rem; border-radius: 999px;
    border: 1px solid rgba(248,242,238,.4);
    font-size: .9rem; font-weight: 600; text-decoration: none;
    transition: background .2s, color .2s;
  }
  .contagem__agenda a:hover, .contagem__agenda a:focus-visible { background: var(--creme); color: var(--verde); outline: none; }

  @media (prefers-reduced-motion: reduce) { .contagem__num.tick { animation: none; } }
</style>
