---
import { evento, linkWhatsApp, mensagemWhatsApp } from "../data/evento";
const [principal, ...outros] = evento.contatos;
const icone = `<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.96-3.48-.23-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43a9.37 9.37 0 0 1 6.67 2.77 9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.44 9.43m8.03-17.46A11.27 11.27 0 0 0 12.05.7C5.8.7.7 5.8.7 12.06c0 2 .52 3.95 1.52 5.67L.6 23.6l6.02-1.58a11.33 11.33 0 0 0 5.42 1.38h.01c6.26 0 11.35-5.1 11.36-11.36 0-3.03-1.18-5.89-3.33-8.03"/></svg>`;
---
<section class="rsvp" id="confirmar">
  <p class="eyebrow" data-revela>Confirme sua presença</p>
  <h2 data-revela>Posso contar <em>com você?</em></h2>
  <p class="rsvp__prazo" data-revela>Confirme até <strong>{evento.confirmarAte}</strong> pelo WhatsApp.</p>

  <form class="rsvp__form" data-rsvp data-revela>
    <label for="nome">Seu nome</label>
    <input id="nome" name="nome" type="text" autocomplete="name" placeholder="Ex.: Maria Silva" maxlength="80" />
    <p class="rsvp__previa" aria-live="polite">
      <span>Mensagem:</span> <q data-rsvp-previa>{mensagemWhatsApp()}</q>
    </p>

    <a class="rsvp__botao" href={linkWhatsApp(principal.whatsapp)} target="_blank" rel="noopener"
       data-rsvp-link={principal.whatsapp}>
      <Fragment set:html={icone} />
      Confirmar com a {principal.nome}
    </a>
    {outros.map((c) => (
      <a class="rsvp__botao rsvp__botao--alt" href={linkWhatsApp(c.whatsapp)} target="_blank" rel="noopener"
         data-rsvp-link={c.whatsapp}>
        <Fragment set:html={icone} />
        ou com a {c.nome}
      </a>
    ))}
  </form>
</section>

<script>
  import { linkWhatsApp, mensagemWhatsApp } from "../data/evento";

  const form = document.querySelector<HTMLFormElement>("[data-rsvp]");
  if (form) {
    const input = form.querySelector<HTMLInputElement>("#nome")!;
    const previa = form.querySelector<HTMLElement>("[data-rsvp-previa]")!;
    const links = form.querySelectorAll<HTMLAnchorElement>("[data-rsvp-link]");

    const atualizar = () => {
      previa.textContent = mensagemWhatsApp(input.value);
      links.forEach((a) => (a.href = linkWhatsApp(a.dataset.rsvpLink!, input.value)));
    };

    // Link personalizado: ?c=Maria ou ?nome=Maria já preenche o nome
    const params = new URLSearchParams(location.search);
    const doLink = params.get("c") ?? params.get("nome");
    if (doLink) input.value = doLink.slice(0, 80);

    input.addEventListener("input", atualizar);
    form.addEventListener("submit", (e) => { e.preventDefault(); links[0].click(); });
    atualizar();
  }
</script>

<style>
  .rsvp {
    background:
      radial-gradient(ellipse at 85% 10%, rgba(245,101,58,.45), transparent 55%),
      linear-gradient(160deg, var(--magenta) 0%, var(--vinho) 70%);
    color: var(--creme);
    padding: clamp(5rem, 14vh, 8rem) var(--gutter);
    text-align: center;
  }
  .eyebrow { color: #ffd4c4; }
  h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(2.4rem, 7vw, 4rem); line-height: 1.05; margin-top: .5rem; }
  h2 em { font-family: var(--script); font-style: normal; font-weight: 400; color: #ffd4c4; font-size: 1.15em; }
  .rsvp__prazo { margin-top: 1rem; font-size: 1.05rem; }
  .rsvp__prazo strong { color: #fff; border-bottom: 2px solid var(--coral); }

  .rsvp__form {
    max-width: 460px; margin: 2.5rem auto 0; text-align: left;
    background: rgba(26,10,17,.28); border: 1px solid rgba(248,242,238,.18);
    border-radius: calc(var(--raio) + 6px); padding: 1.5rem;
    backdrop-filter: blur(6px);
  }
  label { font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  input {
    width: 100%; margin-top: .5rem; padding: .9rem 1rem;
    font: inherit; font-size: 1.05rem; color: var(--tinta);
    background: var(--creme); border: 2px solid transparent; border-radius: 12px;
  }
  input:focus { outline: none; border-color: var(--coral); }
  .rsvp__previa { font-size: .9rem; margin-top: 1rem; opacity: .9; }
  .rsvp__previa span { font-weight: 700; }
  .rsvp__botao {
    display: flex; align-items: center; justify-content: center; gap: .6rem;
    margin-top: 1.25rem; padding: 1rem 1.25rem;
    background: var(--creme); color: var(--verde);
    font-weight: 700; font-size: 1.05rem; text-decoration: none;
    border-radius: 999px; transition: transform .2s, box-shadow .2s, background .2s;
  }
  .rsvp__botao--alt {
    margin-top: .75rem; padding: .8rem 1.25rem;
    background: transparent; color: var(--creme);
    border: 1.5px solid rgba(248,242,238,.5); font-size: .95rem;
  }
  .rsvp__botao:hover { transform: translateY(-2px); box-shadow: 0 12px 24px -10px rgba(0,0,0,.45); }
  .rsvp__botao--alt:hover { background: rgba(248,242,238,.1); }
  .rsvp__botao:focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; }
</style>
