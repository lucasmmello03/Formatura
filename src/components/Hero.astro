---
import { Image } from "astro:assets";
import retrato from "../assets/fotos/retrato-toga.jpg";
import { evento } from "../data/evento";
---
<section class="hero" data-hero>
  <div class="hero__foto" data-hero-foto>
    <Image
      src={retrato}
      alt={`${evento.formanda} de beca, segurando o capelo`}
      widths={[480, 768, 1080, 1332]}
      sizes="(min-width: 900px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__texto" data-hero-texto>
    <p class="script hero__script hero__linha">Minha Formatura</p>
    <h1 class="hero__nome hero__linha">{evento.formanda}</h1>
    <p class="hero__curso hero__linha">{evento.titulo}</p>
    <p class="hero__data hero__linha">
      <time datetime={evento.dataIso}>{evento.dataCurta}</time>
      <span aria-hidden="true">·</span> {evento.horario}
    </p>
    <p class="hero__faltam hero__linha" data-faltam hidden></p>
  </div>

  <a href="#convite" class="hero__seta" aria-label="Rolar para o convite">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--noite);
  }
  .hero__foto { position: absolute; inset: 0; }
  .hero__foto :global(img) {
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 20%;
    will-change: transform;
  }
  .hero__foto::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(26,10,17,0) 28%, rgba(26,10,17,.82) 56%, var(--noite) 100%);
  }
  .hero__texto {
    position: relative;
    padding: 0 var(--gutter) 6rem;
    text-align: center;
  }
  .hero__script {
    font-size: clamp(2.6rem, 11vw, 5rem);
    line-height: 1.25; color: var(--rosa);
    margin-bottom: .1rem;
  }
  .hero__nome {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(2.3rem, 8vw, 4.75rem);
    line-height: 1.05; letter-spacing: -.01em;
  }
  .hero__curso {
    font-family: var(--serif); font-style: italic; font-size: clamp(1.2rem, 3.5vw, 1.6rem);
    color: var(--texto-suave); margin-top: .4rem;
  }
  .hero__data {
    margin-top: 1rem; font-weight: 700; letter-spacing: .12em; font-size: .95rem;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .hero__data span { color: var(--rosa); margin: 0 .35rem; }
  .hero__faltam {
    display: inline-block; margin-top: .9rem;
    padding: .4rem .95rem; border-radius: 999px;
    background: rgba(232,62,140,.16); border: 1px solid rgba(232,62,140,.5);
    color: #ffd0e3; font-size: .85rem; font-weight: 600; letter-spacing: .02em;
  }
  .hero__faltam[hidden] { display: none; }

  .hero__seta {
    position: absolute; bottom: 1.5rem; left: 50%; translate: -50% 0;
    width: 26px; height: 42px; border: 1.5px solid var(--texto-suave); border-radius: 20px;
  }
  .hero__seta span {
    position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px;
    border-radius: 2px; background: var(--rosa); animation: rola 1.8s infinite;
  }
  @keyframes rola { 0% { opacity: 0; transform: translateY(0) } 30% { opacity: 1 } 100% { opacity: 0; transform: translateY(14px) } }

  @media (min-width: 900px) {
    .hero { grid-template-columns: 1fr 1fr; align-items: center; }
    .hero__foto { left: auto; width: 50%; }
    .hero__foto::after {
      background: linear-gradient(to right, var(--noite) 0%, rgba(26,10,17,0) 35%),
                  linear-gradient(to top, var(--noite) 0%, rgba(26,10,17,0) 25%);
    }
    .hero__texto { grid-column: 1; text-align: left; padding: 0 2rem 0 var(--gutter); }
  }
  @media (prefers-reduced-motion: reduce) { .hero__seta span { animation: none; } }
</style>
